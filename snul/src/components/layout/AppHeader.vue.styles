  align-items: center;
  gap: 6px;
  transition: all 0.12s ease;
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-primary { background: var(--brand); color: var(--fg-on-brand); border-color: var(--brand); }
.btn-primary:hover { background: var(--brand-hover); }
.btn-ghost { background: var(--wl-surface); color: var(--wl-ink-strong); border-color: var(--wl-border); }
.btn-ghost:hover { background: var(--wl-surface-soft); }
.btn-sm { padding: 6px 12px; font-size: 12.5px; }
.header__user-wrap { position: relative; flex-shrink: 0; }
.header__user {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0.6rem 0.25rem 0.25rem;
  border: 1px solid var(--wl-border);
